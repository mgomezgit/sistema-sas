# ==================================================================
# Plataforma Reservas - plantilla de configuracion.
# Copiala a .env y completa los valores. NUNCA subas el .env real.
# Los valores de aqui son los de un entorno LOCAL de desarrollo; para
# produccion revisa los comentarios marcados con [PROD].
# ==================================================================

# --- Aplicacion ---
APP_NAME="Plataforma Reservas"
# local en desarrollo. [PROD] production
APP_ENV=local
# Se genera con: php artisan key:generate
APP_KEY=
# [PROD] false: con true se muestran errores con datos internos
APP_DEBUG=true
# URL publica exacta, sin barra final. [PROD] https://tu-dominio
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
# Zona horaria de los horarios, reservas, recordatorios y vigencias
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Costo del hash de las claves
BCRYPT_ROUNDS=12

# --- Logs ---
LOG_CHANNEL=stack
# [PROD] daily, para rotar el archivo por dia
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# [PROD] warning o error
LOG_LEVEL=debug

# --- Base de datos (MySQL 8.4) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sesiones (login manual sobre la tabla sessions) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# [PROD] con HTTPS: true, para que la cookie de sesion solo viaje cifrada.
# No la actives en local con http o no podras iniciar sesion.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Las imagenes de banners van al disco "public" (requiere php artisan storage:link)
FILESYSTEM_DISK=local

# --- Colas: todos los correos se encolan; requiere php artisan queue:work ---
QUEUE_CONNECTION=database

# --- Cache (tambien guarda el historial del chatbot y los limitadores) ---
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo. En local: Mailpit (bandeja en http://localhost:8025) ---
# [PROD] el servidor SMTP real (host, puerto, usuario, clave y MAIL_SCHEME)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@plataformareservas.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Contacto de la plataforma (config/plataforma.php) ---
# Lo muestran los correos de vencimiento y los mensajes de modulo bloqueado.
# Contacto vacio = texto generico "comunicate con soporte".
PLATAFORMA_NOMBRE="la plataforma"
PLATAFORMA_CONTACTO_WHATSAPP=
PLATAFORMA_CONTACTO_CORREO=

# --- Proveedor de IA (chatbot y asistente creativo) ---
# Clave de la API de OpenAI. Solo aqui, nunca en el repositorio.
OPENAI_API_KEY=

# --- Chatbot de la pagina publica (config/chatbot.php) ---
# Interruptor global: false apaga el chatbot en toda la plataforma
CHATBOT_HABILITADO=true
# Mensajes al mes por negocio (si el negocio no tiene limite propio)
CHATBOT_LIMITE_MENSUAL=100
# Tope de mensajes al mes de TODA la plataforma
CHATBOT_TOPE_GLOBAL_MENSUAL=1500
CHATBOT_LONGITUD_MAXIMA_MENSAJE=500
# Turnos de conversacion que se recuerdan
CHATBOT_MAX_TURNOS=6
CHATBOT_MAX_MENSAJES_CONVERSACION=20
# Minutos de inactividad tras los que vence la conversacion
CHATBOT_VIDA_CONVERSACION=15
CHATBOT_TOKENS_MAX_SALIDA=300
CHATBOT_PROVEEDOR=openai
CHATBOT_MODELO=gpt-6-luna
CHATBOT_ESFUERZO_RAZONAMIENTO=none
CHATBOT_ESPERA_BLOQUEO=5
# Segundos de espera maxima a la IA
CHATBOT_TIMEOUT=20
# Limitadores por IP
CHATBOT_MENSAJES_MINUTO_IP=6
CHATBOT_MENSAJES_HORA_IP=40
CHATBOT_TERMINAR_MINUTO_IP=20

# --- Asistente creativo, modulo "ia" (config/ia.php) ---
# Interruptor global: false apaga el asistente en toda la plataforma
IA_HABILITADO=true
# Generaciones al mes por negocio (si el negocio no tiene limite propio)
IA_LIMITE_MENSUAL=40
# Tope de generaciones al mes de TODA la plataforma
IA_TOPE_GLOBAL_MENSUAL=1000
IA_TOKENS_MAX_SALIDA=400
# Estas tres heredan de las CHATBOT_* si NO estan definidas. Dejalas comentadas:
# definidas vacias darian una cadena vacia y romperian esa herencia.
# IA_PROVEEDOR=openai
# IA_MODELO=gpt-6-luna
# IA_ESFUERZO_RAZONAMIENTO=none
IA_TIMEOUT=30
IA_ESPERA_BLOQUEO=5
# Limitadores por usuario
IA_POR_MINUTO_USUARIO=10
IA_POR_HORA_USUARIO=100
